{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/patient",
      "dest": "/public/patient.html"
    },
    {
      "src": "/caregiver",
      "dest": "/public/caregiver.html"
    },
    {
      "src": "/counselor",
      "dest": "/public/counselor.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
