<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100 selection:bg-rose-500 selection:text-white">
<head>
  <title>Sahaay (സഹായം) | Zero-Typing SUD Recovery Lifeline Kerala</title>
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  <meta name="theme-color" content="#0f172a">
  <meta name="description" content="Sahaay is a multi-modal, zero-typing GenAI emergency intervention platform for Substance Use Disorder recovery in Kerala.">

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- Tailwind CSS CDN for instant presentation excellence -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/@hotwired/turbo@7.3.0/dist/turbo.es2015.umd.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/stimulus@3.2.2/dist/stimulus.umd.js"></script>

  <!-- Google Fonts Inter & Noto Serif Malayalam -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Serif+Malayalam:wght@400;600;700&display=swap" rel="stylesheet">

  <style>
    body { font-family: 'Inter', system-ui, -apple-system, sans-serif; }
    .font-malayalam { font-family: 'Noto Serif Malayalam', Georgia, serif; }
    @keyframes pulse-ring {
      0% { transform: scale(0.95); opacity: 0.8; }
      50% { transform: scale(1.15); opacity: 0.4; }
      100% { transform: scale(0.95); opacity: 0.8; }
    }
    .animate-pulse-ring { animation: pulse-ring 3s infinite ease-in-out; }
  </style>
</head>
<body class="h-full flex flex-col justify-between p-3 sm:p-4 max-w-md mx-auto relative antialiased">
  <%= yield %>
</body>
</html>
